# Copy this file to config.env and fill in YOUR values. Never commit config.env.
# Get these from App Store Connect → Users and Access → Integrations → App Store Connect API
# https://appstoreconnect.apple.com/access/integrations/api

# The Key ID shown in the Team Keys table (e.g. AB12CD34EF)
ASC_KEY_ID=

# The Issuer ID shown at the top of the API keys page (a UUID)
ASC_ISSUER_ID=

# Full path to the .p8 private key file you downloaded (only downloadable once!)
ASC_P8_PATH=

# ---- App values (sane defaults, change if you want) ----
BUNDLE_ID=com.luckyclover.aceofaces
APP_NAME=1918: Ace of Aces
APP_SKU=ACEOFACES001
APP_DESCRIPTION_NAME=1918 Ace of Aces
