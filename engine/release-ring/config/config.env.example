# One Ring config — describe your app ONCE, ship it EVERYWHERE.
# cp config.env.example → config.env (repo root) and fill in.

# ---------- Apple App Store ----------
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_P8_PATH=
IOS_BUNDLE_ID=com.luckyclover.aceofaces

# ---------- Google Play ----------
GOOGLE_SA_JSON=
ANDROID_PACKAGE=com.luckyclover.aceofaces

# ---------- App metadata (used by the lint agent, per-store limits applied) ----------
APP_NAME=1918: Ace of Aces
APP_SUBTITLE=WWI dogfighting arcade shooter
APP_KEYWORDS=ww1,shooter,arcade,biplane,dogfight,retro
APP_SHORT_DESC=Arcade WWI dogfighter. Take the SPAD XIII over the trenches.
APP_FULL_DESC=1918: Ace of Aces is an arcade WWI shoot-em-up. Pilot a SPAD XIII through six sorties of the Great War: balloon busting, trench strafing, and duels with the Red Baron's Flying Circus. Barrel-roll through flak, call in wingmen, and earn your wings.
APP_PROMO_TEXT=Six sorties. One war. Your wings.

# ---------- Release ----------
APP_VERSION=1.0.0
# Path to your signed .aab for Google Play uploads (Apple uses Transporter separately)
AAB_PATH=

# ---------- Docs + screenshots + GitHub (scribe / photographer / herald) ----------
# Contact email shown on your privacy policy + support page (stores require one)
CONTACT_EMAIL=
# Playable URL of your game — the photographer captures store screenshots from it
SHOT_URL=
# GitHub token (repo scope) — the herald pushes docs/ and enables Pages
GITHUB_TOKEN=
# Public repo the docs live in (created automatically if missing)
GITHUB_REPO=1918-ace-of-aces-docs
